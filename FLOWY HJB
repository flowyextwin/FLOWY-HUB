
-- FLOWY HUB V3.0 ALPHA
-- LocalScript: StarterPlayerScripts

local Players = game:GetService("Players")
local player = Players.LocalPlayer

local config = {
    AutoFarm = false,
    AutoClick = false,
    Fly = false,
    Height = 8,
    CPS = 10
}

local gui = Instance.new("ScreenGui")
gui.Name = "FlowyHub"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local frame = Instance.new("Frame")
frame.Size = UDim2.fromOffset(280, 310)
frame.Position = UDim2.new(0.5, -140, 0.5, -155)
frame.BackgroundColor3 = Color3.fromRGB(18, 13, 26)
frame.Parent = gui

Instance.new("UICorner", frame)

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 50)
title.BackgroundTransparency = 1
title.Text = "FLOWY HUB V3.0"
title.TextColor3 = Color3.fromRGB(190, 135, 255)
title.Font = Enum.Font.GothamBold
title.TextSize = 22
title.Parent = frame

local function toggle(name, key, y)
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(1, -24, 0, 40)
    button.Position = UDim2.fromOffset(12, y)
    button.BackgroundColor3 = Color3.fromRGB(42, 30, 58)
    button.TextColor3 = Color3.new(1, 1, 1)
    button.TextSize = 15
    button.Text = name .. ": OFF"
    button.Parent = frame

    Instance.new("UICorner", button)

    button.Activated:Connect(function()
        config[key] = not config[key]
        button.Text = name ..
            (config[key] and ": ON" or ": OFF")
        button.BackgroundColor3 = config[key]
            and Color3.fromRGB(135, 65, 220)
            or Color3.fromRGB(42, 30, 58)
    end)
end

toggle("Smart Auto Farm", "AutoFarm", 60)
toggle("Smart Auto Click", "AutoClick", 110)
toggle("Smart Farm Fly", "Fly", 160)

local height = Instance.new("TextBox")
height.Size = UDim2.new(1, -24, 0, 35)
height.Position = UDim2.fromOffset(12, 210)
height.BackgroundColor3 = Color3.fromRGB(42, 30, 58)
height.TextColor3 = Color3.new(1, 1, 1)
height.Text = tostring(config.Height)
height.Parent = frame

height.FocusLost:Connect(function()
    config.Height = math.clamp(
        tonumber(height.Text) or 8, 3, 25
    )
    height.Text = tostring(config.Height)
end)

local status = Instance.new("TextLabel")
status.Size = UDim2.new(1, 0, 0, 45)
status.Position = UDim2.fromOffset(0, 255)
status.BackgroundTransparency = 1
status.TextColor3 = Color3.fromRGB(190, 135, 255)
status.Text = "FLOWY DEVELOPMENT"
status.Parent = frame

task.spawn(function()
    while gui.Parent do
        if config.AutoFarm then
            status.Text = "Farm Test: ACTIVE"
        elseif config.AutoClick then
            status.Text = "Click Test: ACTIVE"
        elseif config.Fly then
            status.Text = "Fly Test: ACTIVE"
        else
            status.Text = "FLOWY DEVELOPMENT"
        end
        task.wait(0.1)
    end
end)
